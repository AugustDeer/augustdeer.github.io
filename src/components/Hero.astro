---
import Slots from "./Slots.astro";

const months = [
  "September",
  "October",
  "November",
  "December",
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
];
---

<div
  class="relative grid min-h-screen grid-cols-1 place-items-center content-center-safe bg-mist-800"
>
  <div
    class="absolute top-1/3 left-2/5 block h-30 w-50 rotate-12 bg-emerald-700 blur-2xl select-none"
  >
  </div>
  <h1
    class="z-10 text-center text-4xl/normal font-bold tracking-wide text-balance text-white"
  >
    Hi, I'm <Slots slots={months}>August</Slots> Deer!
  </h1>
  <p
    class="z-10 mt-8 text-center text-xl/8 font-light tracking-tight text-pretty text-mist-300"
  >
    Developer, Close-Up Magician, Science Communicator, Classical Pianist.
  </p>
</div>
