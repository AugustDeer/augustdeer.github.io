---
import Slots from "./Slots.astro";

const months = [
  "September",
  "October",
  "November",
  "December",
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
];
---

<div class="relative mx-auto max-w-2xl rounded-xl bg-gray-600 py-6">
  <h1 class="text-center text-6xl/normal font-normal text-gray-50">
    Hi, I'm <span class="font-extralight">
      <Slots slots={months}><span class="font-bold">August</span></Slots>
    </span> Deer!
  </h1>
  <p class="text-center text-xl/loose font-light tracking-tight text-gray-100">
    Developer, Close-Up Magician, Science Communicator, Classical Pianist.
  </p>
</div>
