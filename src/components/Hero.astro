---
import Slots from "./Slots.astro";

const months = ["January", "February", "March", "April", "May", "June", "July"];
---

<div class="hero">
  <h1>
    Hi, I'm <Slots slots={months}>August</Slots> Deer!
  </h1>
  <p>Developer, Close-Up Magician, Science Communicator, Classical Pianist.</p>
</div>

<style>
  .hero {
    background-color: lightgray;
    text-align: center;
    padding: 10px;
    border-radius: 10px;
  }
</style>
