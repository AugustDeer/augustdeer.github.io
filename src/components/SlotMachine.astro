---
interface Props {
  slots: string[];
}

const { slots = [] } = Astro.props;

const slotCount = slots.length;
---

<slot-machine>
  {
    slots.map((slot) => (
      <span hidden aria-hidden>
        {slot}
      </span>
    ))
  }
  <span><slot /></span>
</slot-machine>

<style>
  slot-machine {
    box-sizing: content-box;
    height: 1lh;
    flex-direction: column;
    place-items: center;
    align-content: center;
    overflow: hidden;

    &.animating {
      display: inline-flex;
      margin-inline: -2.5rem;
      padding-inline: 2.5rem;
    }

    span {
      animation: 1.5s slot-machine;
      justify-content: center;

      &:not(:last-child) {
        font-weight: 200;
        user-select: none;
        width: 0;
        display: inline-flex;
      }
    }
  }
</style>

<style define:vars={{ slotCount }}>
  @keyframes slot-machine {
    0% {
      transform: translateY(1lh);
    }
    100% {
      transform: translateY(calc(var(--slotCount) * -1lh));
    }
  }
</style>

<script>
  class SlotMachine extends HTMLElement {
    connectedCallback() {
      const ANIMATING_CLASS = "animating";

      this.classList.add(ANIMATING_CLASS);

      const slots = Array.from(this.children);

      const rest = slots.slice(0, -1);

      for (const slot of rest) {
        slot.removeAttribute("hidden");
      }

      this.addEventListener(
        "animationend",
        () => {
          for (const slot of rest) {
            slot.remove();
          }
          this.classList.remove(ANIMATING_CLASS);
        },
        { once: true },
      );
    }
  }

  customElements.define("slot-machine", SlotMachine);
</script>
