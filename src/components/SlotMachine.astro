---
interface Props {
  slots: string[];
}

const { slots = [] } = Astro.props;
---

<slot-machine>
  <span class="slot-machine-inner">
    {
      slots.map((slot) => (
        <span class="slot-machine-slot" hidden aria-hidden>
          {slot}
        </span>
      ))
    }
    <span class="slot-machine-slot"><slot /></span>
  </span>
</slot-machine>

<script>
  class SlotMachine extends HTMLElement {
    connectedCallback() {
      const ANIMATING_CLASS = "animating";

      const inner = this.children.item(0);
      if (inner === null) {
        return;
      }
      const slots = Array.from(inner.children);
      const rest = slots.slice(0, -1);

      this.classList.add(ANIMATING_CLASS);
      for (const slot of rest) {
        slot.removeAttribute("hidden");
      }

      this.addEventListener(
        "animationend",
        () => {
          for (const slot of rest) {
            slot.remove();
          }
          this.classList.remove(ANIMATING_CLASS);
        },
        { once: true },
      );
    }
  }

  customElements.define("slot-machine", SlotMachine);
</script>
