---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<div
  class="items-center gap-5 rounded-4xl bg-mist-800 p-5 outline-2 outline-emerald-500 sm:flex"
>
  <div class="basis-1/4">
    <h2
      class="text-center text-xl font-semibold text-balance text-mist-100 sm:text-right sm:text-2xl"
    >
      {name}
    </h2>
  </div>
  <div class="basis-3/4 text-base text-pretty text-mist-100 sm:text-lg">
    <slot />
  </div>
</div>
