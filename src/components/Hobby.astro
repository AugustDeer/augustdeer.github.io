---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<div
  class="flex flex-wrap items-center gap-5 rounded-4xl bg-mist-800 p-5 outline-2 outline-emerald-500 sm:flex-nowrap"
>
  <div class="basis-full sm:basis-1/4">
    <h2
      class="text-center text-xl sm:text-2xl font-semibold text-balance text-mist-100 sm:text-right"
    >
      {name}
    </h2>
  </div>
  <div class="basis-full text-base sm:text-lg text-pretty text-mist-100 sm:basis-3/4">
    <slot />
  </div>
</div>
