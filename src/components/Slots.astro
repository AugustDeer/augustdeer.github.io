---
interface Props {
  slots: string[];
}

const { slots = [] } = Astro.props;

const slotCount = slots.length;
---

<slot-machine
  class="box-content h-lh flex-col place-items-center content-center overflow-hidden"
>
  {
    slots.map((slot) => (
      <span hidden aria-hidden>
        {slot}
      </span>
    ))
  }
  <span><slot /></span>
</slot-machine>

<style define:vars={{ slotCount }}>
  span {
    animation: 1.5s slot-machine;

    &:not(:last-child) {
      display: flex;
      user-select: none;
      width: 0;
      justify-content: center;
    }
  }

  @keyframes slot-machine {
    0% {
      transform: translateY(1lh);
    }
    100% {
      transform: translateY(calc(var(--slotCount) * -1lh));
    }
  }
</style>

<script>
  class SlotMachine extends HTMLElement {
    connectedCallback() {
      const ANIMATING_CLASSES = ["inline-flex", "-mx-10", "px-10"]

      this.classList.add(...ANIMATING_CLASSES);

      const slots = Array.from(this.children);

      const rest = slots.slice(0, -1);

      for (const slot of rest) {
        slot.removeAttribute("hidden");
      }

      this.addEventListener(
        "animationend",
        () => {
          for (const slot of rest) {
            slot.remove();
          }
          this.classList.remove(...ANIMATING_CLASSES);
        },
        { once: true },
      );
    }
  }

  customElements.define("slot-machine", SlotMachine);
</script>
