---
interface Props {
  slots: string[];
}

const { slots = [] } = Astro.props;

const slotCount = slots.length;
---

<slot-machine
  class="box-content h-lh flex-col place-items-center content-center overflow-hidden px-10 -mx-10"
>
  {
    slots.map((slot) => (
      <span hidden aria-hidden>
        {slot}
      </span>
    ))
  }
  <span><slot /></span>
</slot-machine>

<style define:vars={{ slotCount }}>
  span {
    animation: 1.5s slot-machine;

    &:not(:last-child) {
      user-select: none;
    }
  }

  @keyframes slot-machine {
    0% {
      transform: translateY(1lh);
    }
    100% {
      transform: translateY(calc(var(--slotCount) * -1lh));
    }
  }
</style>

<script>
  class SlotMachine extends HTMLElement {
    connectedCallback() {
      this.classList.add("inline-flex")

      const slots = Array.from(this.children);

      const final = slots.at(-1);
      const rest = slots.slice(0,-1);

      if (final) {
        const width = final.getBoundingClientRect().width;
        this.style.width = width.toString() + "px";
      }

      for (const slot of rest) {
        slot.removeAttribute("hidden");
      }

      this.addEventListener("animationend", () => {
        for (const slot of rest) {
          slot.remove();
        }
        this.style.removeProperty("width");
        this.classList.remove("inline-flex");
      })
    }
  }

  customElements.define("slot-machine", SlotMachine);
</script>
