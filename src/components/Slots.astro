---
interface Props {
  slots: string[];
}

const { slots = [] } = Astro.props;

const slotCount = slots.length;
---

<slot-machine class="slots">
  {
    slots.map((slot) => (
      <span class="slot-value" aria-hidden>
        {slot}
      </span>
    ))
  }
  <span class="slot-value"><slot /></span>
</slot-machine>

<style>
  slot-machine {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    padding-inline: 1em;
    margin-inline: -1em;
    height: 1lh;
  }
</style>

<style define:vars={{ slotCount }}>
  .slot-value {
    transform: translateY(calc(var(--slotCount) * -1lh));
    animation: 1.5s slot-machine;

    &:not(:last-child) {
      user-select: none;
    }
  }
  
  @keyframes slot-machine {
    0% {
      transform: translateY(1lh);
    }
  }
</style>

<script>
  class SlotMachine extends HTMLElement {
    connectedCallback() {
      const final = this.querySelector(".slot-value:last-child");
      console.log(final);
      if (final) {
        const width = final.getBoundingClientRect().width;
        this.style.width = width.toString() + 'px';
      }
    }
  }

  customElements.define("slot-machine", SlotMachine);
</script>
