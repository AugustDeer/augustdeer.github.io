---
import Layout from "../layouts/Layout.astro";
import SlotMachine from "../components/SlotMachine.astro";
import Hobby from "../components/Hobby.astro";

const months = [
  "September",
  "October",
  "November",
  "December",
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
];
---

<Layout>
  <div
    class="relative min-h-screen place-items-center overflow-hidden bg-mist-800"
  >
    <div
      class="absolute inset-0 bg-radial from-transparent from-90% to-emerald-500 bg-size-[16px_16px] bg-fixed"
    >
    </div>
    <div class="fixed h-screen content-center">
      <h1
        class="relative z-10 text-center text-4xl/normal font-bold tracking-wide text-balance text-white"
      >
        Hi, I'm <SlotMachine slots={months}>August</SlotMachine> Deer!<span
          class="absolute inset-0 -top-1/2 -z-10 h-2/1 w-50 origin-center -rotate-12 content-around place-self-center rounded-full bg-emerald-700 blur-2xl select-none"
        ></span>
      </h1>
      <p
        class="relative z-10 mt-8 text-center text-xl/8 font-light tracking-tight text-pretty text-mist-300"
      >
        Developer, Science Communicator, Close-Up Magician.
      </p>
    </div>
  </div>

  <div class="relative bg-emerald-950">
    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-y-32 py-32 px-8">
      <div class="flex flex-row">
        <div class="grow"></div>
        <div class="md:max-w-2xl">
          <Hobby name="Computer Science">
            Frontend, backend, Python, Rust, even a tiny bit of Haskell. I'm a
            jack of all trades. I'm capable with AI coding tools, but skilled
            enough to not need them. (This website was <a
              class="underline decoration-emerald-400"
              href="https://github.com/AugustDeer/augustdeer.github.io"
              >coded entirely by hand</a
            >!)
          </Hobby>
        </div>
      </div>
      <div class="flex flex-row">
        <div class="md:max-w-2xl">
          <Hobby name="Science Communication">
            The only thing I love more than learning about complex science is
            explaining it to other people. Check out my award winning <a
              class="underline decoration-emerald-400"
              href="https://www.youtube.com/watch?v=ZVo_RrL-tRI"
              >video on the one-electron universe hypothesis</a
            >.
          </Hobby>
        </div>
        <div class="grow"></div>
      </div>
      <div class="flex flex-row">
        <div class="grow"></div>
        <div class="md:max-w-2xl">
          <Hobby name="Close‑Up Magic">
            Like every kid, I got one of those magic kits that you play with for
            2 seconds and then put into a closet somewhere, except I kept
            playing. Now I perform at the Magic Castle in Hollywood, and
            occasionally even on live television. (Did you know I was an extra
            on <a
              href="https://www.youtube.com/watch?v=vZYMbSHRoas"
              class="underline decoration-emerald-400">America's Got Talent</a
            >?)
          </Hobby>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-mist-800 text-white">
    <div class="w-lg mx-auto py-20">
      <h3 class="font-bold">Contact Me:</h3>
      <ul class="list-disc list-inside">
        <li>
          Email: <a class="underline" href="mailto:august@augustdeer.com">august@augustdeer.com</a>
        </li>
      </ul>
    </div>
  </div>
</Layout>
