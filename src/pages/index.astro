---
import "../styles/index.css";

import Layout from "../layouts/Layout.astro";
import SlotMachine from "../components/SlotMachine.astro";

const months = [
  "September",
  "October",
  "November",
  "December",
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
];
---

<Layout>
  <div class="hero-wrapper">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <h1>
        Hi, I'm <SlotMachine slots={months}>August</SlotMachine> Deer!
      </h1>
      <h3>Developer, Science Communicator, Close-Up Magician.</h3>
    </div>
  </div>

  <div class="hobbies-wrapper">
    <div class="hobbies">
      <div class="hobby-wrapper">
        <div class="hobby">
          <h2>Computer Science</h2>
          <p>
            Frontend, Backend, Python, Rust, even a tiny bit of Haskell. I'm a
            jack of all trades. I'm capable with AI coding tools, but skilled
            enough to not need them. (This website was <a
              href="https://github.com/AugustDeer/augustdeer.github.io"
              >coded entirely by hand</a
            >!)
          </p>
        </div>
      </div>
      <div class="hobby-wrapper">
        <div class="hobby">
          <h2>Science Communication</h2>
          <p>
            The only thing I love more than learning about complex science is
            explaining it to other people. Check out my award winning <a
              href="https://www.youtube.com/watch?v=ZVo_RrL-tRI"
            >
              video on the one-electron universe hypothesis
            </a>.
          </p>
        </div>
      </div>
      <div class="hobby-wrapper">
        <div class="hobby">
          <h2>Close-Up Magic</h2>
          <p>
            Like every kid, I got one of those magic kits that you play with for
            2 seconds and then put into a closet somewhere, except I kept
            playing. Now I perform at the Magic Castle in Hollywood, and
            occasionally even on live television. (Did you know I was an extra
            on <a href="https://www.youtube.com/watch?v=vZYMbSHRoas"
              >America's Got Talent</a
            >?)
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="contacts">
    <h3>Where to find me:</h3>
    <ul>
      <li>
        YouTube: <a href="www.youtube.com/@augustdeer">@augustdeer</a>
      </li>
      <li>
        Bluesky: <a href="https://bsky.app/profile/augustdeer.com"
          >@augustdeer.com</a
        >
      </li>
      <li>
        Email: <a href="mailto:august@augustdeer.com">august@augustdeer.com</a>
      </li>
    </ul>
  </div>
</Layout>
