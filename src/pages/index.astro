---
import Layout from "../layouts/Layout.astro";
import Slots from "../components/Slots.astro";
import Hobby from "../components/Hobby.astro";

const months = [
  "September",
  "October",
  "November",
  "December",
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
];
---

